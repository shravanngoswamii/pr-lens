                ]
              },
              {
                "id": "reject-state",
                "from": "state",
                "to": "method-error",
                "label": "fails with",
                "status": "observed",
                "text": "The integer initial_state probe raised MethodError on base.",
                "refs": [
                  "base-fallbacks",
