  "sections": [
    {
      "id": "overview",
      "title": "In plain English",
      "blocks": [
        {
          "type": "text",
          "text": "Starting several sampling chains with invalid input should produce a useful error. An annotation prevented two error-handling methods from being defined. Moving it inside the methods restores the intended error.",
          "refs": [
            "pr",
            "base-fallbacks",
            "head-fallbacks"
          ]
        }
      ]
    },
    {
      "id": "purpose",
      "title": "Design",
      "blocks": [
        {
          "type": "text",
          "text": "Julia issue 49512 explains why @nospecialize around a function definition can consume it. This PR places the annotation inside each fallback.",
          "refs": [
            "pr",
            "julia-issue",
            "base-fallbacks",
            "head-fallbacks"
          ]
        },
        {
          "type": "text",
          "text": "Nothing uses the default. AbstractArray inputs are checked against nchains. Other types reach an ArgumentError naming initial_params or initial_state.",
          "refs": [
            "head-fallbacks",
            "serial",
            "threads",
            "distributed"
          ]
        }
      ]
    },
    {
      "id": "behavior",
      "title": "Behavior",
      "blocks": [
        {
          "type": "code",
          "title": "Public call used for the state case",
          "language": "julia",
          "code": "using AbstractMCMC, Random\nstruct ProbeModel <: AbstractMCMC.AbstractModel end\nstruct ProbeSampler <: AbstractMCMC.AbstractSampler end\nsample(MersenneTwister(42), ProbeModel(), ProbeSampler(),\n       MCMCSerial(), 3, 4; progress=false, initial_state=10)"
        },
        {
          "type": "compare",
          "title": "Unsupported initial_state = 10",
          "before": "Base 418afe0: MethodError from check_initial_state(::Int64, ::Int64). The generic fallback method is absent.",
          "after": "Head 3aac86b: ArgumentError: initial_state must be specified as a vector of length equal to the number of chains or `nothing`. The generic fallback method exists.",
          "refs": [
            "base-fallbacks",
            "head-fallbacks"
          ]
        },
        {
          "type": "text",
          "text": "All six invalid calls across MCMCSerial, MCMCThreads and MCMCDistributed changed from MethodError to ArgumentError. No sampler step ran. The second case used initial_params=(a=1.0, b=2.0)."
        }
      ]
    },
    {
      "id": "design",
      "title": "Call path",
      "blocks": [
        {
          "type": "diagram",
          "id": "serial-validation",
          "title": "initial_state rejection",
          "direction": "LR",
          "text": "MCMCSerial path for integer initial_state and default initial_params. Other default ensembles use the same validators.",
          "refs": [
            "sample-rng",
            "serial",
            "threads",
            "distributed",
            "head-fallbacks"
          ],
          "nodes": [
            {
              "id": "sample-rng",
              "label": "sample",
              "kind": "method",
              "signature": "StatsBase.sample(rng::Random.AbstractRNG, model::AbstractModel, sampler::AbstractSampler, parallel::AbstractMCMCEnsemble, N::Integer, nchains::Integer; kwargs...)",
              "text": "Dispatches to mcmcsample by ensemble.",
              "refs": [
                "sample-rng"
              ]
            },
            {
              "id": "serial",
              "label": "mcmcsample",
              "kind": "method",
              "signature": "mcmcsample(rng::Random.AbstractRNG, model::AbstractModel, sampler::AbstractSampler, ::MCMCSerial, N::Integer, nchains::Integer; progressname=\"Sampling\", initial_params=nothing, initial_state=nothing, kwargs...)",
              "text": "Checks initial_params, then initial_state, before sampling chains.",
              "refs": [
                "serial"
              ]
            },
            {
              "id": "state",
              "label": "state fallback",
              "kind": "method",
              "signature": "check_initial_state(x::Any, n::Any)",
              "text": "Rejects inputs outside the more specific Nothing and AbstractArray methods.",
              "refs": [
                "head-fallbacks"
              ]
            },
            {
              "id": "argument-error",
              "label": "ArgumentError",
              "kind": "type",
              "text": "Names the keyword and requests one value per chain or nothing. The message says vector.",
              "refs": [
                "head-fallbacks"
              ]
            }
          ],
          "edges": [
            {
              "id": "select-serial",
              "from": "sample-rng",
              "to": "serial",
              "label": "calls",
              "status": "source",
              "text": "MCMCSerial selects this method.",
              "refs": [
                "sample-rng",
                "serial"
              ]
            },
            {
              "id": "validate-state",
              "from": "serial",
              "to": "state",
              "label": "calls",
              "status": "source",
              "text": "After initial_params passes. Inputs other than Nothing or AbstractArray select the fallback.",
              "refs": [
                "serial",
                "head-fallbacks"
              ]
            },
            {
              "id": "reject-state",
              "from": "state",
              "to": "argument-error",
              "label": "throws",
              "status": "source",
              "text": "Always throws the initial_state ArgumentError.",
              "refs": [
                "head-fallbacks"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "review-actions",
      "title": "Patch and next check",
      "blocks": [
        {
          "type": "diff",
          "title": "Define the fallback",
          "text": "The PR changes initial_params and initial_state this way. The public probe covers both.",
          "path": "src/sample.jl",
          "before": "@nospecialize check_initial_params(x, n) = throw(\n    ArgumentError(\n        \"initial_params must be specified as a vector of length equal to the number of chains or `nothing`\",\n    ),\n)\ncheck_initial_params(::Nothing, n) = nothing\n",
          "after": "function check_initial_params(x, n)\n    @nospecialize\n    throw(\n        ArgumentError(\n            \"initial_params must be specified as a vector of length equal to the number of chains or `nothing`\",\n        ),\n    )\nend\ncheck_initial_params(::Nothing, n) = nothing\n",
          "scope": "pr",
          "verification": "tested",
          "refs": [
            "base-fallbacks",
            "head-fallbacks"
          ]
        },
        {
          "type": "text",
          "text": "The current PR title and body are already concise.",
          "refs": [
            "pr"
          ]
        },
        {
          "type": "prompt",
          "title": "Check the fallback",
          "text": "Use the public API on both revisions.",
          "instructions": "Run examples/abstractmcmc-222.jl on the exact base and head. Check invalid initial_state and initial_params across all three default ensembles, then the serial controls. Confirm invalid inputs fail before sampling. Report Julia and package revisions.",
          "refs": [
            "base-fallbacks",
            "head-fallbacks",
            "serial",
            "threads",
            "distributed"
          ]
        }
      ]
    },
