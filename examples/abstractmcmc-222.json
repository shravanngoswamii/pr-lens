          "baseline": {
            "revision": "418afe0df723635aa6c228eb7b12c09a849c8380",
            "scope": "The selected serial input-validation path. Syntax alone does not establish that the fallback is defined at runtime.",
            "nodes": [
              {
                "id": "sample-rng",
                "label": "sample",
                "kind": "method",
                "signature": "StatsBase.sample(rng::Random.AbstractRNG, model::AbstractModel, sampler::AbstractSampler, parallel::AbstractMCMCEnsemble, N::Integer, nchains::Integer; kwargs...)",
                "text": "Dispatches to mcmcsample by ensemble.",
                "refs": [
                  "baseline-sample-rng"
                ]
              },
              {
                "id": "serial",
                "label": "mcmcsample",
                "kind": "method",
                "signature": "mcmcsample(rng::Random.AbstractRNG, model::AbstractModel, sampler::AbstractSampler, ::MCMCSerial, N::Integer, nchains::Integer; progressname=\"Sampling\", initial_params=nothing, initial_state=nothing, kwargs...)",
                "text": "Checks initial_params, then initial_state, before sampling chains.",
                "refs": [
                  "baseline-serial"
                ]
              },
              {
                "id": "state",
                "label": "state fallback",
                "kind": "method",
                "signature": "check_initial_state(x::Any, n::Any)",
                "text": "The generic fallback declaration is present in source but @nospecialize prevents the intended method from being defined.",
                "refs": [
                  "base-fallbacks"
                ]
              },
              {
                "id": "method-error",
                "label": "MethodError",
                "kind": "type",
                "text": "Dispatch fails because the intended generic fallback was not defined.",
                "refs": [
                  "base-fallbacks",
